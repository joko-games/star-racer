// Cascade (v0.1.4): a mountain road through the city rather than a circuit, 34 m from wall to
// wall and 5.17 km round. It climbs a mountainside of the city in five banked hairpins to a
// summit 119 m up, leaps off it, comes down in steps, threads a walled canyon and runs home
// through the valley at the bottom of the lap, the city rising on every side.
//
//   the launch           out of the line, east, through the city
//   the ridge            a fast S toward the foot of the mountain
//   the switchbacks      five hairpins, banked 30 degrees, climbing from 32 to 110 m between
//                        districts stacked up the slope, a tower in every hairpin
//   the summit           along the crest, and the leap: 95 m missing, the road taking up
//                        again 22 m lower, between two monoliths
//   the cascade          down in steps, meandering west: 24 m and 28 m missing, hops
//   the falls            140 m missing on the long straight down: the thruster's
//   the bend             a banked left at the foot of the falls
//   the canyon           south, pinched to 22 m between walls of the city, through a chicane
//   the corner           a banked left into the valley, the lowest part of the lap
//   the valley           a long sweep east through the middle of the city
//   the lasso            a tight loop out to the right and back
//   the run home         the starting grid sits along it
//
// The shortcut (docs/tracks.md#cascade): the lasso leaves its line and comes back to it, so a car
// that flies straight on over the wall on the thruster, from the end of the straight before it,
// lands on the road coming back, about 430 m skipped. No checkpoint stands inside it.
//
// The turn angles add up to one full turn to the left; the two lengths marked A and B were
// solved for so the loop closes. The format is described in docs/tracks.md.
(
    name: "Cascade",
    width: 34.0,
    segments: [
        // The launch.
        Straight(length: 200.0),
        // The ridge.
        Turn(angle: 30.0, radius: 150.0, transition: 30.0, banking: 10.0),
        Turn(angle: -55.0, radius: 130.0, transition: 30.0, banking: 14.0),
        Turn(angle: 25.0, radius: 150.0, transition: 30.0, banking: 10.0),
        Straight(length: 60.0),
        // The switchbacks: five hairpins up the mountain.
        Turn(angle: 180.0, radius: 46.0, transition: 22.0, banking: 30.0),
        Straight(length: 210.0),
        Turn(angle: -180.0, radius: 44.0, transition: 22.0, banking: 30.0),
        Straight(length: 150.0),
        Turn(angle: 180.0, radius: 50.0, transition: 22.0, banking: 30.0),
        Straight(length: 230.0),
        Turn(angle: -180.0, radius: 44.0, transition: 22.0, banking: 30.0),
        Straight(length: 170.0),
        Turn(angle: 180.0, radius: 48.0, transition: 22.0, banking: 30.0),
        Straight(length: 150.0),
        // The summit, and the leap.
        Straight(length: 140.0),
        // The cascade, down in steps.
        Turn(angle: 35.0, radius: 120.0, transition: 25.0, banking: 12.0),
        Straight(length: 90.0),
        Turn(angle: -65.0, radius: 140.0, transition: 30.0, banking: 16.0),
        Straight(length: 120.0),
        Turn(angle: 50.0, radius: 100.0, transition: 25.0, banking: 16.0),
        Straight(length: 60.0),
        // The falls.
        Turn(angle: -20.0, radius: 140.0, transition: 25.0, banking: 8.0),
        Straight(length: 260.0),
        // The bend.
        Turn(angle: 90.0, radius: 64.0, transition: 26.0, banking: 26.0),
        // The canyon, and its chicane.
        Straight(length: /*A*/60.87),
        Turn(angle: -45.0, radius: 60.0, transition: 20.0, banking: 12.0),
        Turn(angle: 90.0, radius: 60.0, transition: 20.0, banking: 20.0),
        Turn(angle: -45.0, radius: 60.0, transition: 20.0, banking: 12.0),
        Straight(length: 40.0),
        // The corner, and the valley.
        Turn(angle: 90.0, radius: 64.0, transition: 26.0, banking: 28.0),
        Turn(angle: 25.0, radius: 170.0, transition: 30.0, banking: 10.0),
        Turn(angle: -25.0, radius: 170.0, transition: 30.0, banking: 10.0),
        Straight(length: 40.0),
        // The lasso.
        Turn(angle: -108.0, radius: 40.0, transition: 20.0, banking: 20.0),
        Straight(length: 25.0),
        Turn(angle: 216.0, radius: 52.0, transition: 26.0, banking: 30.0),
        Straight(length: 25.0),
        Turn(angle: -108.0, radius: 40.0, transition: 20.0, banking: 20.0),
        Straight(length: /*B*/140.58),
        // The run home. The starting grid sits along it.
        Straight(length: 200.0),
    ],
    elevation: [
